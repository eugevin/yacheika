# Copy to .env and fill in.
# Domain (or subdomain) whose A record points at this VPS; the game is https://DOMAIN
DOMAIN=game.example.com
# Public IPv4 address of the VPS, for coturn (TURN relays voice by IP, it needs no certificate)
PUBLIC_IP=203.0.113.10
# Shared by the game server and coturn for TURN credentials. Generate: openssl rand -hex 32
TURN_SECRET=
